# Master orchestrator for {{ project_name }}
# Runs XX01-XX99 scripts by phase in canonical order:
#   S -> L -> P -> V -> M -> A -> V (diagnostics) -> O (LAST)
# V## appears twice by design (data quality, then model diagnostics).
# The optional XX00_run_all.R in a phase folder is a standalone convenience
# runner for that one phase; it is skipped here so nothing runs twice.
#
# Usage:
#   Rscript run.R              Full pipeline
#   Rscript run.R --dry-run    List what would run; run nothing
PHASE_DIRS <- list('S' = 'setup', 'L' = 'loading', 'P' = 'processing',
                   'V' = 'validation', 'M' = 'manual', 'A' = 'analysis',
                   'O' = 'outputs', 'E' = 'exploration')

args <- commandArgs(trailingOnly = TRUE)
dry_run <- '--dry-run' %in% args

for (phase in strsplit('SLPVMAVO', '')[[1]]) {
  dir <- file.path('code', PHASE_DIRS[[phase]])
  scripts <- sort(list.files(dir, pattern = paste0('^', phase, '[0-9]{2}_.*\\.R$'),
                             full.names = TRUE))
  scripts <- scripts[!startsWith(basename(scripts), paste0(phase, '00_'))]
  for (s in scripts) {
    cat(phase, basename(s), '\n')
    if (!dry_run) source(s)
  }
}
